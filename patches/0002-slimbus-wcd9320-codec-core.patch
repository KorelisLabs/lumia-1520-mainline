+					   cyc, chn[ch],
+					   wcd->hs_latched[cyc][ch]);
+			for (p = 0; p < 3; p++)
+				n += sysfs_emit_at(buf, n,
+						   "c%d%s_%s_30d=%02x c%d%s_%s_1b3=%02x c%d%s_%s_1b9=%02x\n",
+						   cyc, chn[ch], ph[p],
+						   wcd->hs_sample[cyc][ch][p][0],
+						   cyc, chn[ch], ph[p],
+						   wcd->hs_sample[cyc][ch][p][1],
+						   cyc, chn[ch], ph[p],
+						   wcd->hs_sample[cyc][ch][p][2]);
