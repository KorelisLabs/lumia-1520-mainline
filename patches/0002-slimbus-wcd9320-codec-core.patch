+static ssize_t wcd9320_emit_dump_n(char *buf, const u8 *d, bool have,
+				   unsigned int count)
+{
+	int len = 0;
+	unsigned int i;
+
+	if (!have)
+		return sysfs_emit(buf, "not captured\n");
+
+	for (i = 0; i < count; i++) {
+		len += sysfs_emit_at(buf, len, "%02x", d[i]);
+		if ((i & 31) == 31)
+			len += sysfs_emit_at(buf, len, "\n");
+	}
+	if (count & 31)
+		len += sysfs_emit_at(buf, len, "\n");
+	return len;
+}
