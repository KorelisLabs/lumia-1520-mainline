+static const struct regmap_irq_chip wcd9320_irq_chip = {
+	.name		= "wcd9320",
+	.status_base	= WCD9320_A_INTR_STATUS0,
+	.mask_base	= WCD9320_A_INTR_MASK0,
+	.ack_base	= WCD9320_A_INTR_CLEAR0,
