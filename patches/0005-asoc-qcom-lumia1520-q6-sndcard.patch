From: Lumia 1520 mainline port
Subject: [PATCH] ASoC: qcom: Nokia Lumia 1520 QDSP6 sound card

The real QDSP6 playback topology, replacing the dummy CPU side of the
minimal diagnostic card:

  MultiMedia1 FE (q6asm-dais, ASM 7)
      | DPCM, via the "SLIMBUS_0_RX Audio Mixer" DAPM control
  SLIMBUS_0_RX BE (q6afe-dais, AFE 4, port 0x4000)
      |
  wcd9320-slim-rx1 (codec slave port 16)

Links come from DT and are resolved by qcom_snd_parse_of(), not written in
C. Measured on hardware: the front-end DAI is NOT called "MultiMedia1" --
q6asm's FE component sets .legacy_dai_naming = 1, so with one declared DAI
ASoC names it after the device. A dai_link naming its CPU "MultiMedia1"
would silently fail to match.

The back end's hw_params sets the AFE receive channel map to {144}, which is
this experiment's hypothesis: that codec slave port 16 corresponds to SLIMbus
channel 144 on AFE port 0x4000. q6slim_hw_params() records only rate and bit
width, so without this the port would be configured with num_channels = 0.
The codec gains no channel-map ABI -- encoding an unproven number into its
permanent interface would be the wrong order.

Separate module from the minimal card on purpose: that card is a frozen proof
oracle. The two are mutually exclusive at runtime, which ASoC enforces itself.

Establishes a control path only: no SLIMbus data channel, no samples.

Not upstream material as it stands: the channel number is provisional.

---

diff -uprN orig/sound/soc/qcom/Kconfig new/sound/soc/qcom/Kconfig
--- orig/sound/soc/qcom/Kconfig	2026-08-22 18:34:40.786861243 -0400
+++ new/sound/soc/qcom/Kconfig	2026-08-22 18:34:40.800972547 -0400
@@ -274,3 +274,23 @@ config SND_SOC_X1E80100
 	  Say Y or M if you want to use audio device on this SoCs.
 
 endif #SND_SOC_QCOM
+
+config SND_SOC_LUMIA1520_Q6
+	tristate "Nokia Lumia 1520 QDSP6 sound card (WCD9320 over SLIMbus)"
+	depends on SND_SOC_QDSP6 && SLIM_WCD9320
+	select SND_SOC_QCOM_COMMON
+	default n
+	help
+	  The real QDSP6 playback topology for the Lumia 1520 (RM-940): the
+	  MultiMedia1 ASM front end, routed through ADM to the SLIMBUS_0_RX
+	  AFE back end, terminating on the WCD9320's RX1 DAI.
+
+	  Deliberately separate from SLIM_WCD9320_LUMIA_CARD, which is a frozen
+	  diagnostic fixture with a dummy CPU side. The two are mutually
+	  exclusive at runtime; ASoC refuses to bind the codec component to a
+	  second card and says so.
+
+	  This establishes a control path only. It allocates no SLIMbus data
+	  channel and moves no samples.
+
+	  If unsure, say N.
diff -uprN orig/sound/soc/qcom/Makefile new/sound/soc/qcom/Makefile
--- orig/sound/soc/qcom/Makefile	2026-08-22 18:34:40.789297781 -0400
+++ new/sound/soc/qcom/Makefile	2026-08-22 18:34:40.836078787 -0400
@@ -47,3 +47,7 @@ obj-$(CONFIG_SND_SOC_QCOM_OFFLOAD_UTILS)
 
 #DSP lib
 obj-$(CONFIG_SND_SOC_QDSP6) += qdsp6/
+
+# Nokia Lumia 1520 QDSP6 machine driver, default off.
+snd-soc-lumia1520-q6-y := lumia1520-q6.o
+obj-$(CONFIG_SND_SOC_LUMIA1520_Q6) += snd-soc-lumia1520-q6.o
diff -uprN orig/sound/soc/qcom/lumia1520-q6.c new/sound/soc/qcom/lumia1520-q6.c
--- orig/sound/soc/qcom/lumia1520-q6.c	1969-12-31 19:00:00.000000000 -0500
+++ new/sound/soc/qcom/lumia1520-q6.c	2026-11-09 18:20:51.022185233 -0500
@@ -0,0 +1,759 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Lumia RM-940 QDSP6 sound card -- Branch A, build 2 of 2.
+ *
+ * The real playback topology, replacing the dummy CPU side of
+ * wcd9320-lumia-card:
+ *
+ *   MultiMedia1 FE   q6asm-dais, APR service ASM (7)   PCM-facing session
+ *        |  DPCM, via the "SLIMBUS_0_RX Audio Mixer" DAPM control
+ *   SLIMBUS_0_RX BE  q6afe-dais, APR service AFE (4)   AFE port 0x4000
+ *        |
+ *   wcd9320-slim-rx1   codec slave port 16
+ *
+ * WHY THIS IS A SEPARATE MODULE FROM wcd9320-lumia-card
+ *
+ * That card is a frozen proof oracle: the RX-callback milestone depends on
+ * it, and the prepare-only helper was calibrated against it. It stays exactly
+ * as it is. This module is the thing under test; keeping them apart means a
+ * failure here cannot be confused with a regression there.
+ *
+ * They are mutually exclusive at runtime, and ASoC enforces that itself --
+ * soc_probe_component() refuses to bind a component to a second card with
+ *
+ *   "Trying to bind component ... but is already bound to card ..."
+ *
+ * and returns -ENODEV. No hand-rolled guard is needed here, and one would only
+ * duplicate a clearer message.
+ *
+ * WHY THE LINKS COME FROM DT AND NOT FROM C
+ *
+ * Measured on boot #155: the front-end DAI is NOT called "MultiMedia1". The
+ * q6asm FE component sets .legacy_dai_naming = 1, so with a single declared
+ * DAI ASoC uses fmt_single_name() and names it after the DEVICE:
+ *
+ *   fe200000.remoteproc:smd-edge:apr:service@7:dais
+ *
+ * A dai_link naming its CPU "MultiMedia1" would silently fail to match. So
+ * links are wired with sound-dai phandles and parsed by qcom_snd_parse_of(),
+ * which resolves names through the component that owns each of_node and also
+ * sets the DPCM flags correctly (dynamic on the FE, no_pcm on the BE).
+ *
+ * THE CHANNEL MAP COMES FROM THE CODEC
+ *
+ * q6slim_hw_params() records only rate and bit width; num_channels and
+ * ch_mapping[] come solely from q6slim_set_channel_map(). Without the call
+ * below, q6afe_dai_prepare() would configure the port with num_channels = 0.
+ *
+ * Channel 144 on slave port 16 WAS a proposal borrowed from apq8096. It is
+ * now hardware evidence: the control-plane milestone had the AFE accept the
+ * pairing, and B1 had the ADSP accept CONNECT_SINK and DEF_ACT_CHAN for it,
+ * with qcom_slim_ngd_enable_stream() returning 0.
+ *
+ * So the number now lives where it belongs. The codec reports its own
+ * physical mapping through .get_channel_map, and this driver relays it to
+ * the AFE. It previously held a second, independent #define of 144 that
+ * nothing forced to equal the codec's -- they matched by luck. A divergence
+ * would have configured the AFE for one channel and the codec for another,
+ * and the symptom would have been a stream that came up cleanly on both
+ * sides and carried nothing.
+ *
+ * The earlier note here said a codec-side channel ABI would be 'the wrong
+ * order'. That was correct at the time: the number was unproven. The order
+ * was measure first, then encode, and this is the encoding step.
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/jack.h>
+#include <sound/soc.h>
+
+#include <dt-bindings/sound/qcom,q6afe.h>
+
+#include "common.h"
+#include "qdsp6/q6afe.h"
+
+#define DRV_NAME	"wcd9320-lumia-q6"
+
+/*
+ * An upper bound for the relay buffers only. This driver deliberately holds
+ * no channel numbers of its own -- see the header. The codec side is slave
+ * port 16, registers 0x180 and 0x040, proven on every boot since the RX-DAI
+ * milestone.
+ */
+#define LUMIA_MAX_SLIM_CH	8
+
+/*
+ * Pin the back end rather than inheriting whatever the front end negotiated.
+ * The codec's frozen delta (0x040: 00->05, 0x180: 00->01) was proven at
+ * 48 kHz / 1 channel / S16_LE, and this milestone compares against that
+ * delta; letting the BE drift would compare against something else.
+ *
+ * r185: TWO CHANNELS. The codec now owns SLIM RX1 and RX2 (ports 16 and 17,
+ * channels 144 and 145) and reports both; the back end is always stereo, and
+ * the front end stays free -- the ADSP's matrix maps a mono stream onto it.
+ */
+static int lumia_q6_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
+				       struct snd_pcm_hw_params *params)
+{
+	struct snd_interval *rate =
+		hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE);
+	struct snd_interval *channels =
+		hw_param_interval(params, SNDRV_PCM_HW_PARAM_CHANNELS);
+
+	rate->min = rate->max = 48000;
+	channels->min = channels->max = 2;
+	snd_mask_set_format(hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT),
+			    SNDRV_PCM_FORMAT_S16_LE);
+
+	return 0;
+}
+
+static int lumia_q6_be_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	unsigned int rx_ch[LUMIA_MAX_SLIM_CH], tx_ch[LUMIA_MAX_SLIM_CH];
+	unsigned int rx_ch_cnt = 0, tx_ch_cnt = 0;
+	int ret, i;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+
+	/*
+	 * Ask the codec what its channels are, then tell the AFE. This driver
+	 * no longer holds an opinion about channel numbers.
+	 *
+	 * It used to carry its own "#define WCD9320_SLIM_RX1_CH 144" while the
+	 * codec carried another, with nothing to keep them equal -- a silent
+	 * mismatch would have configured the AFE for one channel and the codec
+	 * for a different one, and the symptom would have been a stream that
+	 * came up cleanly on both sides and carried nothing. This is the
+	 * mainline ownership model, and it is the one sdm845 uses.
+	 */
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		ret = snd_soc_dai_get_channel_map(codec_dai, &tx_ch_cnt, tx_ch,
+						  &rx_ch_cnt, rx_ch);
+		if (ret == -ENOTSUPP)
+			continue;
+		if (ret) {
+			dev_err(rtd->card->dev,
+				"codec %s would not report its channel map: %d\n",
+				codec_dai->name, ret);
+			return ret;
+		}
+
+		if (!rx_ch_cnt || rx_ch_cnt > LUMIA_MAX_SLIM_CH) {
+			dev_err(rtd->card->dev,
+				"codec %s reported %u receive channels\n",
+				codec_dai->name, rx_ch_cnt);
+			return -EINVAL;
+		}
+
+		ret = snd_soc_dai_set_channel_map(cpu_dai, 0, NULL,
+						  rx_ch_cnt, rx_ch);
+		if (ret && ret != -ENOTSUPP) {
+			dev_err(rtd->card->dev,
+				"failed to set the AFE receive channel map: %d\n",
+				ret);
+			return ret;
+		}
+
+		dev_info(rtd->card->dev,
+			 "BE hw_params: cpu=%s codec=%s rate=%u ch=%u ch_map=%u ch from %u (reported by the codec)\n",
+			 cpu_dai->name, codec_dai->name,
+			 params_rate(params), params_channels(params),
+			 rx_ch_cnt, rx_ch[0]);
+	}
+
+	return 0;
+}
+
+static const struct snd_soc_ops lumia_q6_be_ops = {
+	.hw_params = lumia_q6_be_hw_params,
+};
+
+/*
+ * r189: THE LOUDSPEAKER, ON SECONDARY MI2S.
+ *
+ * docs/audio/r189-sec-mi2s-speaker-mapping.md. r187 and r188 drove every
+ * WCD9320 analog output live to -20 dBFS at full gain and none sounded.
+ * Windows' power-framework entry for the audio device switches what the
+ * codec never did: PM8941 SMPS4 at 5 V / 1.5 A, and TLMM 79..82 to
+ * sec_mi2s. No amplifier sits on any control bus. The loudspeaker is behind
+ * a control-less I2S amplifier, and this component is that amplifier as
+ * Linux sees it -- an unknown part, so it claims no part number.
+ *
+ * It owns the two things the amplifier needs that the AFE does not: the 5 V
+ * rail and the pin mux, both under DAPM. "SPK 5V" is a supply on the output,
+ * so the rail is up only while a stream reaches the Loudspeaker pin. Up: rail,
+ * then pins; down: pins, then rail -- the amplifier never sees the port's
+ * clocks without its supply, and nothing drives its inputs while it is off.
+ *
+ * i2s_spk_state reports the component's own view (supply, pins, bit clock,
+ * counters) and regulator_is_enabled() beside it; the runners cross-check
+ * both against the regulator class and the pinmux debugfs, which this code
+ * does not write.
+ */
+#define LUMIA_MI2S_BCLK_RATE	1536000	/* 48 kHz x 2 x 16 bit */
+
+struct lumia_i2s_spk {
+	struct device *dev;
+	struct regulator *vdd;
+	struct pinctrl *pins;
+	struct pinctrl_state *pins_sleep;
+	struct pinctrl_state *pins_active;
+	struct mutex lock;
+	bool supply_on;
+	bool pins_on;
+	bool bclk_on;
+	unsigned int enables;
+	unsigned int disables;
+	unsigned int bclk_sets;
+	unsigned int bclk_clears;
+	unsigned int errors;
+	int last_err;
+};
+
+static void lumia_i2s_spk_err(struct lumia_i2s_spk *spk, int ret)
+{
+	spk->errors++;
+	spk->last_err = ret;
+}
+
+static int lumia_i2s_spk_supply_event(struct snd_soc_dapm_widget *w,
+				      struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	struct lumia_i2s_spk *spk = snd_soc_component_get_drvdata(c);
+	int ret = 0, r;
+
+	mutex_lock(&spk->lock);
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		ret = regulator_enable(spk->vdd);
+		if (ret) {
+			dev_err(spk->dev, "i2s-spk: the 5 V rail would not enable: %d\n", ret);
+			lumia_i2s_spk_err(spk, ret);
+			break;
+		}
+		spk->supply_on = true;
+		ret = pinctrl_select_state(spk->pins, spk->pins_active);
+		if (ret) {
+			dev_err(spk->dev, "i2s-spk: sec_mi2s pins would not go active: %d -- rail off again\n", ret);
+			lumia_i2s_spk_err(spk, ret);
+			r = regulator_disable(spk->vdd);
+			if (r)
+				lumia_i2s_spk_err(spk, r);
+			else
+				spk->supply_on = false;
+			break;
+		}
+		spk->pins_on = true;
+		spk->enables++;
+		dev_info(spk->dev, "i2s-spk: 5 V rail on (%d uV), sec_mi2s pins active\n",
+			 regulator_get_voltage(spk->vdd));
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		if (spk->pins_on) {
+			r = pinctrl_select_state(spk->pins, spk->pins_sleep);
+			if (r) {
+				dev_err(spk->dev, "i2s-spk: sec_mi2s pins would not sleep: %d\n", r);
+				lumia_i2s_spk_err(spk, r);
+				ret = r;
+			} else {
+				spk->pins_on = false;
+			}
+		}
+		if (spk->supply_on) {
+			r = regulator_disable(spk->vdd);
+			if (r) {
+				dev_err(spk->dev, "i2s-spk: the 5 V rail would not disable: %d\n", r);
+				lumia_i2s_spk_err(spk, r);
+				ret = r;
+			} else {
+				spk->supply_on = false;
+			}
+		}
+		spk->disables++;
+		dev_info(spk->dev, "i2s-spk: sec_mi2s pins asleep, 5 V rail off\n");
+		break;
+	}
+	mutex_unlock(&spk->lock);
+	return ret;
+}
+
+static const struct snd_soc_dapm_widget lumia_i2s_spk_widgets[] = {
+	SND_SOC_DAPM_SUPPLY("SPK 5V", SND_SOC_NOPM, 0, 0,
+			    lumia_i2s_spk_supply_event,
+			    SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_OUTPUT("I2S_SPK_OUT"),
+};
+
+static const struct snd_soc_dapm_route lumia_i2s_spk_routes[] = {
+	{ "I2S_SPK_OUT", NULL, "I2S Speaker Playback" },
+	{ "I2S_SPK_OUT", NULL, "SPK 5V" },
+};
+
+static const struct snd_soc_component_driver lumia_i2s_spk_component = {
+	.dapm_widgets		= lumia_i2s_spk_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(lumia_i2s_spk_widgets),
+	.dapm_routes		= lumia_i2s_spk_routes,
+	.num_dapm_routes	= ARRAY_SIZE(lumia_i2s_spk_routes),
+};
+
+/* What Windows' speaker profile runs (ACDB device 15: 48 kHz, 16 bit). */
+static struct snd_soc_dai_driver lumia_i2s_spk_dai = {
+	.name = "lumia-i2s-spk",
+	.playback = {
+		.stream_name	= "I2S Speaker Playback",
+		.channels_min	= 2,
+		.channels_max	= 2,
+		.rates		= SNDRV_PCM_RATE_48000,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE,
+	},
+};
+
+static ssize_t i2s_spk_state_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct lumia_i2s_spk *spk = dev_get_drvdata(dev);
+	ssize_t n;
+
+	if (!spk)
+		return -ENODEV;
+	mutex_lock(&spk->lock);
+	n = sysfs_emit(buf,
+		       "supply_on=%d pins_active=%d bclk_on=%d enables=%u disables=%u bclk_sets=%u bclk_clears=%u errors=%u last_err=%d vdd_enabled=%d vdd_uV=%d\n",
+		       spk->supply_on, spk->pins_on, spk->bclk_on,
+		       spk->enables, spk->disables, spk->bclk_sets,
+		       spk->bclk_clears, spk->errors, spk->last_err,
+		       regulator_is_enabled(spk->vdd),
+		       regulator_get_voltage(spk->vdd));
+	mutex_unlock(&spk->lock);
+	return n;
+}
+static DEVICE_ATTR_RO(i2s_spk_state);
+
+static struct attribute *lumia_i2s_spk_attrs[] = {
+	&dev_attr_i2s_spk_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(lumia_i2s_spk);
+
+static int lumia_i2s_spk_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct lumia_i2s_spk *spk;
+	int ret;
+
+	spk = devm_kzalloc(dev, sizeof(*spk), GFP_KERNEL);
+	if (!spk)
+		return -ENOMEM;
+	spk->dev = dev;
+	ret = devm_mutex_init(dev, &spk->lock);
+	if (ret)
+		return ret;
+
+	spk->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(spk->vdd))
+		return dev_err_probe(dev, PTR_ERR(spk->vdd), "no vdd (the 5 V rail)\n");
+
+	spk->pins = devm_pinctrl_get(dev);
+	if (IS_ERR(spk->pins))
+		return dev_err_probe(dev, PTR_ERR(spk->pins), "no pinctrl\n");
+	spk->pins_sleep = pinctrl_lookup_state(spk->pins, PINCTRL_STATE_DEFAULT);
+	if (IS_ERR(spk->pins_sleep))
+		return dev_err_probe(dev, PTR_ERR(spk->pins_sleep), "no default (sleep) pin state\n");
+	spk->pins_active = pinctrl_lookup_state(spk->pins, "active");
+	if (IS_ERR(spk->pins_active))
+		return dev_err_probe(dev, PTR_ERR(spk->pins_active), "no active pin state\n");
+
+	/* Explicitly, not only through the driver core's default binding. */
+	ret = pinctrl_select_state(spk->pins, spk->pins_sleep);
+	if (ret)
+		return dev_err_probe(dev, ret, "sec_mi2s pins would not sleep\n");
+
+	if (regulator_is_enabled(spk->vdd) > 0)
+		dev_warn(dev, "i2s-spk: the 5 V rail is already on at probe -- another consumer holds it\n");
+
+	platform_set_drvdata(pdev, spk);
+	ret = devm_snd_soc_register_component(dev, &lumia_i2s_spk_component,
+					      &lumia_i2s_spk_dai, 1);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register the component\n");
+
+	dev_info(dev, "i2s-spk: unknown control-less I2S amplifier on Secondary MI2S; pins asleep, 5 V rail under DAPM\n");
+	return 0;
+}
+
+static const struct of_device_id lumia_i2s_spk_of_match[] = {
+	{ .compatible = "nokia,lumia1520-i2s-spk" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, lumia_i2s_spk_of_match);
+
+static struct platform_driver lumia_i2s_spk_driver = {
+	.probe = lumia_i2s_spk_probe,
+	.driver = {
+		.name = "lumia1520-i2s-spk",
+		.of_match_table = lumia_i2s_spk_of_match,
+		.dev_groups = lumia_i2s_spk_groups,
+	},
+};
+
+/*
+ * r189: the Secondary MI2S back end -- mainline msm8916_qdsp6's recipe on the
+ * same DSP generation: the CPU is clock provider, I2S, and the bit clock is
+ * set per stream with LPAIF_BIT_CLK, which q6afe sends as the legacy
+ * AFE_PARAM_ID_LPAIF_CLK_CONFIG this DSP takes.
+ */
+static struct lumia_i2s_spk *lumia_q6_i2s_spk(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dai *dai;
+	int i;
+
+	for_each_rtd_codec_dais(rtd, i, dai)
+		if (dai->component->driver == &lumia_i2s_spk_component)
+			return snd_soc_component_get_drvdata(dai->component);
+	return NULL;
+}
+
+static int lumia_q6_mi2s_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int ret;
+
+	ret = snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP |
+				  SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF);
+	if (ret)
+		dev_err(rtd->card->dev, "sec_mi2s: the AFE refused the format: %d\n", ret);
+	return ret;
+}
+
+static int lumia_q6_mi2s_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct lumia_i2s_spk *spk = lumia_q6_i2s_spk(rtd);
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_BIT_CLK, LUMIA_MI2S_BCLK_RATE,
+				     SND_SOC_CLOCK_OUT);
+	if (spk) {
+		mutex_lock(&spk->lock);
+		if (ret) {
+			lumia_i2s_spk_err(spk, ret);
+		} else {
+			spk->bclk_on = true;
+			spk->bclk_sets++;
+		}
+		mutex_unlock(&spk->lock);
+	}
+	if (ret)
+		dev_err(rtd->card->dev, "sec_mi2s: bit clock %u Hz refused: %d\n",
+			LUMIA_MI2S_BCLK_RATE, ret);
+	else
+		dev_info(rtd->card->dev, "sec_mi2s: bit clock %u Hz on\n",
+			 LUMIA_MI2S_BCLK_RATE);
+	return ret;
+}
+
+static void lumia_q6_mi2s_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct lumia_i2s_spk *spk = lumia_q6_i2s_spk(rtd);
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_BIT_CLK, 0, SND_SOC_CLOCK_OUT);
+	if (spk) {
+		mutex_lock(&spk->lock);
+		if (ret) {
+			lumia_i2s_spk_err(spk, ret);
+		} else {
+			spk->bclk_on = false;
+			spk->bclk_clears++;
+		}
+		mutex_unlock(&spk->lock);
+	}
+	if (ret)
+		dev_err(rtd->card->dev, "sec_mi2s: bit clock off refused: %d\n", ret);
+	else
+		dev_info(rtd->card->dev, "sec_mi2s: bit clock off\n");
+}
+
+static const struct snd_soc_ops lumia_q6_mi2s_ops = {
+	.startup = lumia_q6_mi2s_startup,
+	.shutdown = lumia_q6_mi2s_shutdown,
+};
+
+/*
+ * qcom_snd_parse_of() marks a link no_pcm exactly when its DT child has BOTH
+ * a codec and a platform node, so this is the same test apq8096 uses to find
+ * its back ends.
+ */
+static void lumia_q6_add_be_ops(struct snd_soc_card *card)
+{
+	struct snd_soc_dai_link *link;
+	int i;
+
+	for_each_card_prelinks(card, i, link) {
+		if (link->no_pcm) {
+			link->be_hw_params_fixup = lumia_q6_be_hw_params_fixup;
+			if (link->id == SECONDARY_MI2S_RX) {
+				/* r189: the loudspeaker's own ops */
+				link->init = lumia_q6_mi2s_init;
+				link->ops = &lumia_q6_mi2s_ops;
+			} else {
+				link->ops = &lumia_q6_be_ops;
+			}
+			dev_info(card->dev, "back end: %s (id %d)\n",
+				 link->name, link->id);
+		} else {
+			/*
+			 * A playback front end wants the SINK up before the
+			 * SOURCE starts, and stopped after it. The ASoC default
+			 * is TRIGGER_PRE, which is the wrong way round at BOTH
+			 * ends, because dpcm_fe_dai_do_trigger() reverses the
+			 * order for STOP: the FE runs first on START and the BE
+			 * first on STOP.
+			 *
+			 * Measured on r158, with the default: exactly ONE period
+			 * completed before the codec's SLIMbus stream was
+			 * enabled, and one more after it was disabled -- 960
+			 * frames, 20 ms, consumed at each end while the codec
+			 * channel was not connected.
+			 *
+			 * TRIGGER_POST inverts both, because ASoC applies the
+			 * same reversal to it. No mainline Qualcomm board sets
+			 * this, so they all carry the same 20 ms glitch; we own
+			 * this link, and the evidence says to fix it.
+			 */
+			link->trigger[SNDRV_PCM_STREAM_PLAYBACK] =
+				SND_SOC_DPCM_TRIGGER_POST;
+			link->trigger[SNDRV_PCM_STREAM_CAPTURE] =
+				SND_SOC_DPCM_TRIGGER_POST;
+			dev_info(card->dev,
+				 "front end: %s (id %d), trigger POST\n",
+				 link->name, link->id);
+		}
+	}
+}
+
+/*
+ * r184: THE HEADPHONE PIN, OFF AT INIT.
+ *
+ * The codec's DAPM graph ends at its HEADPHONE output; this is the board's
+ * jack behind it. An output wired to an HP widget stops being an endpoint by
+ * itself, so with this pin disabled the path from the RX1 DAI is incomplete
+ * and DAPM powers NOTHING on the codec -- not the PA, not even MCLK -- however
+ * much is played.
+ *
+ * That is the safety gate for ordinary playback. The pin is disabled before
+ * the card's first DAPM sync and this driver never enables it.
+ *
+ * r185: THE JACK DRIVES IT. late_probe hands the codec a "Headphone Jack"
+ * whose pin is Headphones; the codec's MBHC jack switch reports insertion and
+ * removal, and ASoC's jack core turns the pin on and off with it. The pin
+ * still starts OFF, the "Headphones Switch" override stays, and a codec that
+ * refuses the jack leaves exactly r184's manual behaviour.
+ */
+/*
+ * r187: the loudspeaker and the earpiece, each a pin that starts OFF and is
+ * switched only by hand ("Speaker Switch", "Earpiece Switch") -- no jack
+ * linkage. Choosing between outputs is UCM's job later; the codec plays one
+ * output at a time and refuses a second.
+ *
+ * r188: the four line outputs, as one "Lineout" pin on the codec's LO_OUT
+ * ("Lineout Switch"), OFF at boot like the others. Which LINEOUTs a stream
+ * drives is the codec's "Lineout Select".
+ *
+ * r189: the real loudspeaker, "Loudspeaker" on the I2S amplifier's output
+ * ("Loudspeaker Switch"), OFF at boot. r187's "Speaker" (the codec's SPK_OUT,
+ * proven silent) stays as a diagnostic path under its old name.
+ */
+static const struct snd_soc_dapm_widget lumia_q6_widgets[] = {
+	SND_SOC_DAPM_HP("Headphones", NULL),
+	SND_SOC_DAPM_SPK("Speaker", NULL),
+	SND_SOC_DAPM_SPK("Earpiece", NULL),
+	SND_SOC_DAPM_LINE("Lineout", NULL),
+	SND_SOC_DAPM_SPK("Loudspeaker", NULL),
+};
+
+static const struct snd_soc_dapm_route lumia_q6_routes[] = {
+	{ "Headphones", NULL, "HEADPHONE" },
+	{ "Speaker", NULL, "SPK_OUT" },
+	{ "Earpiece", NULL, "EAR_OUT" },
+	{ "Lineout", NULL, "LO_OUT" },
+	{ "Loudspeaker", NULL, "I2S_SPK_OUT" },
+};
+
+static const struct snd_kcontrol_new lumia_q6_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Headphones"),
+	SOC_DAPM_PIN_SWITCH("Speaker"),
+	SOC_DAPM_PIN_SWITCH("Earpiece"),
+	SOC_DAPM_PIN_SWITCH("Lineout"),
+	SOC_DAPM_PIN_SWITCH("Loudspeaker"),
+};
+
+static const char * const lumia_q6_pins_off[] = {
+	"Headphones", "Speaker", "Earpiece", "Lineout", "Loudspeaker",
+};
+
+static struct snd_soc_jack lumia_q6_jack;
+
+static struct snd_soc_jack_pin lumia_q6_jack_pins[] = {
+	{ .pin = "Headphones", .mask = SND_JACK_HEADPHONE },
+};
+
+/* The first component on the card that takes a jack: the WCD9320. */
+static struct snd_soc_component *lumia_q6_jack_codec(struct snd_soc_card *card)
+{
+	struct snd_soc_pcm_runtime *rtd;
+	struct snd_soc_dai *dai;
+	int i;
+
+	for_each_card_rtds(card, rtd)
+		for_each_rtd_codec_dais(rtd, i, dai)
+			if (dai->component->driver->set_jack)
+				return dai->component;
+	return NULL;
+}
+
+static int lumia_q6_late_probe(struct snd_soc_card *card)
+{
+	struct snd_soc_component *codec;
+	unsigned int i;
+	int ret;
+
+	/* A card whose pins cannot be put OFF does not register. */
+	for (i = 0; i < ARRAY_SIZE(lumia_q6_pins_off); i++) {
+		ret = snd_soc_dapm_disable_pin(&card->dapm, lumia_q6_pins_off[i]);
+		if (ret) {
+			dev_err(card->dev, "could not disable the %s pin: %d\n",
+				lumia_q6_pins_off[i], ret);
+			return ret;
+		}
+	}
+	dev_info(card->dev,
+		 "Headphones, Speaker, Earpiece, Lineout and Loudspeaker pins OFF at init -- nothing on the codec or the I2S amplifier powers until the jack or a pin switch turns one on\n");
+	ret = snd_soc_dapm_sync(&card->dapm);
+	if (ret)
+		return ret;
+
+	/* r185: the jack. Optional -- without it the pin is manual, as r184. */
+	ret = snd_soc_card_jack_new_pins(card, "Headphone Jack",
+					 SND_JACK_HEADPHONE, &lumia_q6_jack,
+					 lumia_q6_jack_pins,
+					 ARRAY_SIZE(lumia_q6_jack_pins));
+	if (ret) {
+		dev_warn(card->dev, "no Headphone Jack (%d) -- the pin stays manual\n", ret);
+		return 0;
+	}
+	codec = lumia_q6_jack_codec(card);
+	ret = codec ? snd_soc_component_set_jack(codec, &lumia_q6_jack, NULL)
+		    : -ENODEV;
+	if (ret)
+		dev_warn(card->dev,
+			 "the codec did not take the jack (%d) -- the pin stays manual\n",
+			 ret);
+	else
+		dev_info(card->dev, "Headphone Jack -> %s: the jack drives the pin\n",
+			 codec->name);
+	return 0;
+}
+
+static int lumia_q6_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct snd_soc_card *card;
+	int ret;
+
+	card = devm_kzalloc(dev, sizeof(*card), GFP_KERNEL);
+	if (!card)
+		return -ENOMEM;
+
+	card->owner = THIS_MODULE;
+	card->dev = dev;
+	dev_set_drvdata(dev, card);
+
+	/*
+	 * Set BEFORE qcom_snd_parse_of(), which installs its generic jack
+	 * widgets only when the card has none of its own.
+	 */
+	card->dapm_widgets = lumia_q6_widgets;
+	card->num_dapm_widgets = ARRAY_SIZE(lumia_q6_widgets);
+	card->dapm_routes = lumia_q6_routes;
+	card->num_dapm_routes = ARRAY_SIZE(lumia_q6_routes);
+	card->controls = lumia_q6_controls;
+	card->num_controls = ARRAY_SIZE(lumia_q6_controls);
+	card->late_probe = lumia_q6_late_probe;
+
+	/*
+	 * Resolves every sound-dai phandle through the component that owns the
+	 * target of_node, and sets the DPCM flags. A codec phandle that cannot
+	 * be resolved yet returns -EPROBE_DEFER from here -- which is why a
+	 * missing #sound-dai-cells shows up as a card that never registers,
+	 * not as a runtime failure later on.
+	 */
+	ret = qcom_snd_parse_of(card);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse the DT links\n");
+
+	lumia_q6_add_be_ops(card);
+
+	ret = devm_snd_soc_register_card(dev, card);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register the card\n");
+
+	dev_info(dev, "QDSP6 card registered: %d link(s)\n", card->num_links);
+	return 0;
+}
+
+static const struct of_device_id lumia_q6_device_id[] = {
+	{ .compatible = "nokia,lumia1520-q6-sndcard" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, lumia_q6_device_id);
+
+static struct platform_driver lumia_q6_driver = {
+	.probe = lumia_q6_probe,
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = lumia_q6_device_id,
+	},
+};
+
+/* r189: the amplifier first; the card defers until its component exists. */
+static struct platform_driver * const lumia_q6_drivers[] = {
+	&lumia_i2s_spk_driver,
+	&lumia_q6_driver,
+};
+
+static int __init lumia_q6_init(void)
+{
+	return platform_register_drivers(lumia_q6_drivers,
+					 ARRAY_SIZE(lumia_q6_drivers));
+}
+module_init(lumia_q6_init);
+
+static void __exit lumia_q6_exit(void)
+{
+	platform_unregister_drivers(lumia_q6_drivers,
+				    ARRAY_SIZE(lumia_q6_drivers));
+}
+module_exit(lumia_q6_exit);
+
+MODULE_DESCRIPTION("Nokia Lumia 1520 QDSP6 sound card (WCD9320 over SLIMbus, I2S loudspeaker on Secondary MI2S)");
+MODULE_LICENSE("GPL v2");
+MODULE_VERSION("q6-card-rc8");
